{
	"name": "n8n-nodes-revox",
	"version": "1.1.0",
	"license": "MIT",
	"homepage": "https://docs.getrevox.com/n8n/quickstart",
	"description": "n8n community nodes for the Revox AI calling platform",
	"keywords": [
		"n8n-community-node-package",
		"revox",
		"ai",
		"voice",
		"calling",
		"n8n"
	],
	"author": {
		"name": "Revox",
		"email": "support@getrevox.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/daigestapp/n8n-nodes-revox.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"release": "release-it",
		"prepublishOnly": "n8n-node build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/RevoxApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Revox/Revox.node.js",
			"dist/nodes/Revox/RevoxTrigger.node.js"
		]
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@n8n/node-cli": "^0.1.0",
		"eslint": "9.39.0",
		"eslint-import-resolver-typescript": "^4.1.2",
		"eslint-plugin-import-x": "^4.15.2",
		"eslint-plugin-n8n-nodes-base": "1.16.3",
		"rimraf": "^6.0.1",
		"prettier": "3.8.1",
		"release-it": "^19.2.4",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.35.0"
	},
	"peerDependencies": {
		"n8n-workflow": "^1.17.0"
	}
}
